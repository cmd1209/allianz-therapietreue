            {
              "fontFamily": "Alan Sans",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alan-sans/alan-sans-500.ttf"
              ]
            },
            {
              "fontFamily": "Alan Sans",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alan-sans/alan-sans-600.ttf"
              ]
